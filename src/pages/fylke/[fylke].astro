---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import DaySection from "../../components/DaySection.astro";
import Filters from "../../components/Filters.astro";
import IrregularSection from "../../components/IrregularSection.astro";
import { getSiteData } from "../../lib/data.js";
import { osloDate } from "../../lib/date.js";
import { isUndated, occursOn } from "../../lib/occurrence.js";
import { placeSummary } from "../../lib/model.js";
import { formerFylker, fylkeOf } from "../../lib/place.js";
import { quizCount } from "../../lib/format.js";
import { href } from "../../lib/url.js";

export const getStaticPaths = (() => {
  const { items, slugs, venues } = getSiteData();
  const former = formerFylker(venues);

  return [...slugs.byFylke].map(([fylke, slug]) => ({
    params: { fylke: slug },
    props: {
      fylke,
      items: items.filter((item) => fylkeOf(item.venue) === fylke),
      former: former.get(fylke) ?? [],
    },
  }));
}) satisfies GetStaticPaths;

const { fylke, items, former } = Astro.props;
const { slugs, meta } = getSiteData();

// Reads as "tidligere Hordaland og Sogn og Fjordane" - the navigation is our derivation, so
// the page names the source's own counties rather than quietly replacing them.
const joinNb = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(", ")} og ${names.at(-1)}` : (names[0] ?? null);

// A renamed county can say "tidligere X"; one that merely received a municipality cannot,
// because it still exists under its own name. See formerFylker for why they must differ.
const renamedLabel = joinNb(former.filter((f) => f.kommuner.length === 0).map((f) => f.fylke));
const received = former.filter((f) => f.kommuner.length > 0);

const today = osloDate();
const tonight = items.filter((item) => occursOn(item.quiz, today));
const irregular = items.filter((item) => isUndated(item.quiz));
const places = placeSummary(items);
---

<Base
  title={`Pubquiz i ${fylke} – quizkveld`}
  description={`Alle pubquizer i ${fylke}, sted for sted.`}
  generatedAt={meta.generatedAt}
  sourceUpdatedAt={meta.sourceUpdatedAt}
>
  <p class="breadcrumbs">
    <a href={href()}>Forsiden</a> ›
    <a href={href("steder")}>Steder</a> ›
    <span>{fylke}</span>
  </p>

  <div class="intro">
    <h1>Pubquiz i {fylke}</h1>
    {renamedLabel && <p class="intro__former">Tidligere {renamedLabel}.</p>}
    {
      received.map((entry) => (
        <p class="intro__former">
          {joinNb(entry.kommuner)} lå tidligere i {entry.fylke}.
        </p>
      ))
    }
    <p>
      {quizCount(items.length)} på {places.length} steder.
      {
        former.length > 0 &&
          ` Kilden bruker fortsatt fylkesnavnene fra før sammenslåingen i 2020; inndelingen her er dagens.`
      }
    </p>
    <ul class="place-grid">
      {
        places.map((place) => (
          <li>
            <a href={href("sted", slugs.bySted.get(place.sted) ?? "")}>{place.sted}</a>{" "}
            <span class="place-grid__count">({place.count})</span>
          </li>
        ))
      }
    </ul>
  </div>

  <Filters items={items} showPlace={true} />

  <DaySection
    date={today}
    today={today}
    items={tonight}
    slugs={slugs}
    grouping="sted"
    emptyText={`Ingen faste quizer i ${fylke} i kveld.`}
  />

  <IrregularSection items={irregular} slugs={slugs} grouping="sted" scope={`i ${fylke}`} />
</Base>
