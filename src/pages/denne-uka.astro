---
import Base from "../layouts/Base.astro";
import DaySection from "../components/DaySection.astro";
import Filters from "../components/Filters.astro";
import IrregularSection from "../components/IrregularSection.astro";
import { getSiteData } from "../lib/data.js";
import { osloDate, weekWindow } from "../lib/date.js";
import { splitByDates } from "../lib/occurrence.js";
import { quizCount } from "../lib/format.js";
import { DEFAULT_PLACE } from "../lib/site.js";

const { items, slugs, meta } = getSiteData();

const today = osloDate();
// A rolling seven days rather than Monday-to-Sunday: someone looking on a Saturday wants
// the coming week, not the two days left of this one.
const dates = weekWindow(today);

const { dated, undated } = splitByDates(items, dates);
const total = [...dated.values()].reduce((sum, list) => sum + list.length, 0);
const totalInDefaultPlace = [...dated.values()].reduce(
  (sum, list) => sum + list.filter((item) => item.venue.kommune === DEFAULT_PLACE).length,
  0,
);
---

<Base
  title="Pubquizer i Oslo denne uka – quizkveld"
  description="Finn pubquizer i Oslo de neste sju dagene, eller velg Hele landet for å se resten av Norge."
  generatedAt={meta.generatedAt}
  sourceUpdatedAt={meta.sourceUpdatedAt}
  current="denne-uka"
>
  <div class="intro">
    <h1>Denne uka i Oslo</h1>
    <p>
      De neste sju dagene, dag for dag. {quizCount(totalInDefaultPlace)} står oppført i Oslo.
      Velg «Hele landet» for alle {quizCount(total)} i Norge. En quiz som går hver uke
      teller én gang per dag den går.
    </p>
  </div>

  <Filters items={items} defaultPlace={DEFAULT_PLACE} />

  {
    dates.map((date) => (
      <DaySection
        date={date}
        today={today}
        items={dated.get(date) ?? []}
        slugs={slugs}
        grouping="sted"
        emptyText="Ingen faste quizer denne dagen."
      />
    ))
  }

  <IrregularSection items={undated} slugs={slugs} grouping="sted" />
</Base>
