---
import Base from "../layouts/Base.astro";
import DaySection from "../components/DaySection.astro";
import Filters from "../components/Filters.astro";
import IrregularSection from "../components/IrregularSection.astro";
import { loadSiteData } from "../lib/data.js";
import { addDays, osloDate } from "../lib/date.js";
import { isUndated, occursOn } from "../lib/occurrence.js";
import { longDate, quizCount } from "../lib/format.js";
import { DEFAULT_PLACE } from "../lib/site.js";
import { href } from "../lib/url.js";

const { items, slugs, meta } = await loadSiteData();

const today = osloDate();
const tomorrow = addDays(today, 1);

const listed = items.filter((item) => occursOn(item.quiz, tomorrow));
const listedInDefaultPlace = listed.filter((item) => item.venue.kommune === DEFAULT_PLACE);
const irregular = items.filter((item) => isUndated(item.quiz));
---

<Base
  title="Pubquiz i Oslo i morgen – quizkveld"
  description="Finn pubquiz i Oslo i morgen, eller velg Hele landet for å se pubquizer i resten av Norge."
  generatedAt={meta.generatedAt}
  sourceUpdatedAt={meta.sourceUpdatedAt}
  current="i-morgen"
>
  <div class="intro">
    <h1>I Oslo i morgen</h1>
    <p>
      {quizCount(listedInDefaultPlace.length)} står oppført i Oslo {longDate(tomorrow)}.
      Oslo vises først; velg «Hele landet» for resten av Norge.
    </p>
  </div>

  <Filters items={items} showWeekday={false} defaultPlace={DEFAULT_PLACE} />

  <DaySection
    date={tomorrow}
    today={today}
    items={listed}
    slugs={slugs}
    emptyText="Ingen faste quizer er oppført i morgen."
  />

  <p>
    <a href={href()}>Se i kveld</a> · <a href={href("denne-uka")}>Se hele uka</a>
  </p>

  <IrregularSection items={irregular} slugs={slugs} />
</Base>
