---
import Base from "../layouts/Base.astro";
import DaySection from "../components/DaySection.astro";
import Filters from "../components/Filters.astro";
import IrregularSection from "../components/IrregularSection.astro";
import { getSiteData } from "../lib/data.js";
import { osloDate } from "../lib/date.js";
import { isUndated, occursOn } from "../lib/occurrence.js";
import { longDate, quizCount } from "../lib/format.js";
import { DEFAULT_PLACE } from "../lib/site.js";
import { href } from "../lib/url.js";

const { items, slugs, meta } = getSiteData();

// Built in CI, which runs in UTC. `osloDate` is the only reason this page does not claim
// tomorrow is tonight for every build that starts after 22:00 Norwegian time.
const today = osloDate();

const tonight = items.filter((item) => occursOn(item.quiz, today));
const tonightInDefaultPlace = tonight.filter((item) => item.venue.kommune === DEFAULT_PLACE);
const irregular = items.filter((item) => isUndated(item.quiz));
---

<Base
  title="Pubquiz i Oslo i kveld – quizkveld"
  description="Finn pubquiz i Oslo i kveld, eller velg Hele landet for å se pubquizer i resten av Norge."
  generatedAt={meta.generatedAt}
  sourceUpdatedAt={meta.sourceUpdatedAt}
  current="i-kveld"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">En uavhengig oversikt / Pubquiz i Norge</p>
      <h1 id="hero-title">Finn en quiz.<br />Ta med laget.</h1>
      <p class="hero__intro">
        Du trenger ikke kunne alt. Bare vite hvor du skal.
        Her finner du pubquizer i Oslo og resten av landet.
      </p>
      <div class="hero__actions">
        <a class="button-link" href="#finn-quiz">Se kveldens quizer <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={href("denne-uka")}>Planlegg uka <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="tonight-note" aria-label="Oppføringer i Oslo i kveld">
      <p class="tonight-note__label">Oslo / I kveld</p>
      <p class="tonight-note__date">{longDate(today)}</p>
      <p class="tonight-note__number">{String(tonightInDefaultPlace.length).padStart(2, "0")}</p>
      <p class="tonight-note__caption">oppførte {tonightInDefaultPlace.length === 1 ? "quiz" : "quizer"} i Oslo</p>
      <p class="tonight-note__source">Fra Norges Quizforbunds liste.<br />Sjekk med stedet før du drar.</p>
    </aside>
  </section>

  <section id="finn-quiz" class="finder" aria-labelledby="finder-title">
    <div class="finder__heading">
      <div>
        <p class="eyebrow">Finn deres neste quiz</p>
        <h2 id="finder-title">Hvor går turen?</h2>
      </div>
      <p>{quizCount(tonightInDefaultPlace.length)} oppført i Oslo i kveld.<br />Velg «Hele landet» for resten av Norge.</p>
    </div>
    <Filters items={items} showWeekday={false} defaultPlace={DEFAULT_PLACE} />
  </section>

  <DaySection
    date={today}
    today={today}
    items={tonight}
    slugs={slugs}
    emptyText="Ingen faste quizer er oppført i kveld. Se om det er noe i morgen, eller sjekk de uregelmessige nederst."
  />

  <div class="next-night">
    <p>Passer det bedre en annen kveld?</p>
    <a href={href("i-morgen")}>Se i morgen <span aria-hidden="true">↗</span></a>
    <a href={href("denne-uka")}>Se hele uka <span aria-hidden="true">↗</span></a>
  </div>

  <IrregularSection items={irregular} slugs={slugs} />
</Base>
