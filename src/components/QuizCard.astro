---
import type { QuizAtVenue } from "../lib/model.js";
import type { Occurrence } from "../lib/occurrence.js";
import { caveatOf } from "../lib/occurrence.js";
import { categoryLabel, recurrenceLabel, timeLabel } from "../lib/format.js";
import { href } from "../lib/url.js";
import { fylkeOf } from "../lib/place.js";

interface Props {
  item: QuizAtVenue;
  /**
   * How firmly the quiz is tied to the date it is listed under. `likely` means the weekday
   * is right but the week is not knowable - see src/lib/occurrence.ts.
   */
  occurrence?: Occurrence;
  stedSlug: string;
  /** Set on venue pages, where repeating the venue name on every card is noise. */
  showVenue?: boolean;
  /** Set when the list is already grouped under a place heading. */
  showPlace?: boolean;
}

const { item, occurrence = "certain", stedSlug, showVenue = true, showPlace = true } = Astro.props;
const { quiz, venue } = item;

const uncertain = occurrence === "likely";
const undated = occurrence === "undated";

// `likely` has two causes and they deserve different wording. Biweekly means we know the
// weekday but not the week; a caveat means the source itself hedged, in which case its own
// words say it better than any label we could write.
const biweekly = quiz.recurrence.kind === "biweekly";
const caveat = undated ? null : caveatOf(quiz);
// A caveat found in the genre field looks like a genre unless we say where it came from.
const caveatIntro = caveat?.field === "category" ? "Kilden skriver i sjangerfeltet" : "Kilden skriver";
const badgeLabel = biweekly ? "Annenhver uke – sjekk selv" : "Sjekk selv";
const badgeTitle = biweekly
  ? "Kilden sier annenhver uke, men ikke hvilken. Sjekk med stedet før du drar."
  : `Kilden tar forbehold: «${caveat?.text ?? quiz.recurrence.raw}». Sjekk med stedet før du drar.`;

// The modifier is what turns the spine solid, dashed or absent. Purely visual: every state
// it marks is also stated in words inside the entry.
const occurrenceClass =
  occurrence === "certain" ? "" : ` quiz-card--${occurrence === "likely" ? "likely" : "undated"}`;
---

<li
  class={`quiz-card${occurrenceClass}`}
  data-quiz
  data-quiz-id={quiz.id}
  data-sted={venue.kommune}
  data-fylke={fylkeOf(venue)}
  data-weekday={quiz.weekday ?? ""}
  data-categories={quiz.categoryNorm.join(" ")}
>
  {
    quiz.time ? (
      <p class="quiz-card__time">{quiz.time}</p>
    ) : (
      /* Keeps the time column's rhythm when there is no time. The wording that carries the
         information sits in the body below, as real text. */
      <p class="quiz-card__time quiz-card__time--unknown" aria-hidden="true">
        –
      </p>
    )
  }

  <div class="quiz-card__body">
    {
      showVenue && (
        <p class="quiz-card__venue">
          <a href={href("pub", venue.id)}>{venue.name}</a>
        </p>
      )
    }

    {
      showPlace && (
        <p class="quiz-card__place">
          <a href={href("sted", stedSlug)}>{venue.kommune}</a>
        </p>
      )
    }

    {!quiz.time && <p class="quiz-card__meta">{timeLabel(quiz.time)}</p>}

    {
      undated ? (
        <blockquote class="quiz-card__raw">
          <p>{quiz.recurrence.raw}</p>
          <cite>slik kilden beskriver det</cite>
        </blockquote>
      ) : (
        <p class="quiz-card__meta">{recurrenceLabel(quiz.recurrence, quiz.weekday)}</p>
      )
    }

    {caveat && <p class="quiz-card__caveat">{caveatIntro}: «{caveat.text}»</p>}

    <ul class="badges">
      {
        quiz.categoryNorm.map((category) => (
          <li class="badge badge--category">{categoryLabel(category)}</li>
        ))
      }
      {
        uncertain && (
          <li class="badge badge--uncertain" title={badgeTitle}>
            {badgeLabel}
          </li>
        )
      }
    </ul>

    {quiz.note && <p class="quiz-card__meta">{quiz.note}</p>}
  </div>
</li>
